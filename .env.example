# ─────────────────────────────────────────────────────────────────────────────
# Zarova — Environment Variables Reference
#
# API (.env in apps/api/):
#   Copy the API section to apps/api/.env
#
# Frontend (.env.local in apps/web/):
#   Copy the Frontend section to apps/web/.env.local
#
# NEVER commit .env or .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ══════════════════════════════════════════════════════════════════════════════
# API — apps/api/.env
# ══════════════════════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────────────────────
# Railway: auto-set when you attach a Postgres service as DATABASE_URL
DATABASE_URL=postgresql://zarova:zarova_password@localhost:5432/zarova

# Postgres credentials (used by docker-compose.prod.yml only)
POSTGRES_USER=zarova
POSTGRES_PASSWORD=zarova_password
POSTGRES_DB=zarova

# ── App ───────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=your-very-long-random-secret-change-in-production

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
# Gmail: enable 2FA then generate an App Password at myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password
EMAIL_FROM=Zarova <noreply@zarova.com>

# ── Paystack ──────────────────────────────────────────────────────────────────
# Get keys from https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxx

# ── Frontend URL (CORS origin + password-reset email links) ──────────────────
# Set to your Vercel deployment URL, e.g. https://zarova.vercel.app
FRONTEND_URL=https://your-app.vercel.app

# ══════════════════════════════════════════════════════════════════════════════
# FRONTEND — apps/web/.env.local
# ══════════════════════════════════════════════════════════════════════════════

# Set to your Railway API URL, e.g. https://zarova-api.up.railway.app
NEXT_PUBLIC_API_URL=https://your-api.up.railway.app
