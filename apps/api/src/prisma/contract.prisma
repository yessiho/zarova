// use prisma-next
// Contract inferred from the live database schema. Edit as needed, then run `prisma contract emit`.

// ============================================================
// ADMIN
// ============================================================

model Admin {
  id               Int                   @id(map: "admin_pkey") @default(autoincrement())
  createdAt        Timestamptz           @default(now())
  email            String                @unique(map: "admin_email_key")
  firstName        String
  lastName         String
  passwordHash     String
  status           String                @default("ACTIVE")
  updatedAt        Timestamptz

  // RBAC
  roleAssignments  AdminRoleAssignment[]

  // Admin audit trail
  auditLogs        AuditLog[]

  @@check(expression: "(status = ANY (ARRAY['ACTIVE'::text, 'SUSPENDED'::text, 'DEACTIVATED'::text]))", map: "admin_status_check_5dec1c59")
  @@map("admin")
}


// ============================================================
// ADMIN ROLES
// ============================================================

model AdminRole {
  id              Int                   @id(map: "adminRole_pkey") @default(autoincrement())
  code            String                @unique(map: "adminRole_code_key")
  name            String
  description     String?
  isActive        Boolean               @default(true)
  createdAt       Timestamptz           @default(now())
  updatedAt       Timestamptz

  assignments     AdminRoleAssignment[]
  rolePermissions RolePermission[]

  @@map("adminRole")
}


// ============================================================
// PERMISSIONS
// ============================================================

model Permission {
  id              Int              @id(map: "permission_pkey") @default(autoincrement())
  code            String           @unique(map: "permission_code_key")
  name            String
  description     String?
  isActive        Boolean          @default(true)
  createdAt       Timestamptz      @default(now())
  updatedAt       Timestamptz

  rolePermissions RolePermission[]

  @@map("permission")
}


// ============================================================
// ADMIN ROLE ASSIGNMENTS
// ============================================================

model AdminRoleAssignment {
  id          Int         @id(map: "adminRoleAssignment_pkey") @default(autoincrement())
  adminId     Int
  roleId      Int
  isActive    Boolean     @default(true)
  createdAt   Timestamptz @default(now())
  updatedAt   Timestamptz

  admin       Admin       @relation(fields:[adminId], references:[id], map: "adminRoleAssignment_adminId_fkey")
  role        AdminRole   @relation(fields:[roleId], references:[id], map: "adminRoleAssignment_roleId_fkey")

  @@unique([adminId, roleId], map: "adminRoleAssignment_adminId_roleId_key")
  @@index([adminId], name: "adminRoleAssignment_adminId_idx")
  @@index([roleId], name: "adminRoleAssignment_roleId_idx")
  @@map("adminRoleAssignment")
}


// ============================================================
// ROLE PERMISSIONS
// ============================================================

model RolePermission {
  id           Int         @id(map: "rolePermission_pkey") @default(autoincrement())
  roleId       Int
  permissionId Int
  isActive     Boolean     @default(true)
  createdAt    Timestamptz @default(now())
  updatedAt   Timestamptz

  role         AdminRole   @relation(fields:[roleId], references:[id], map: "rolePermission_roleId_fkey")
  permission   Permission  @relation(fields:[permissionId], references:[id], map: "rolePermission_permissionId_fkey")

  @@unique([roleId, permissionId], map: "rolePermission_roleId_permissionId_key")
  @@index([roleId], name: "rolePermission_roleId_idx")
  @@index([permissionId], name: "rolePermission_permissionId_idx")
  @@map("rolePermission")
}


// ============================================================
// USER
// ============================================================

model User {
  id                   Int          @id(map: "user_pkey") @default(autoincrement())
  createdAt            Timestamptz  @default(now())
  email                String       @unique(map: "user_email_key")
  firstName            String
  lastName             String
  passwordHash         String
  status               String       @default("ACTIVE")
  updatedAt            Timestamptz
  passwordResetExpires Timestamptz?
  passwordResetToken   String?
  auditLogs            AuditLog[]
  wallets              Wallet[]

  @@check(expression: "(status = ANY (ARRAY['ACTIVE'::text, 'SUSPENDED'::text, 'DEACTIVATED'::text]))", map: "user_status_check_5dec1c59")
  @@map("user")
}


// ============================================================
// AUDIT LOG
// ============================================================

model AuditLog {
  id        Int         @id(map: "auditLog_pkey") @default(autoincrement())
  action    String
  createdAt Timestamptz @default(now())
  entity    String
  entityId  String?
  metadata  String?
  userId    Int?
  adminId   Int?

  user      User?       @relation(fields:[userId], references:[id], map: "auditLog_userId_fkey")
  admin     Admin?      @relation(fields:[adminId], references:[id], map: "auditLog_adminId_fkey")

  @@index([entity, entityId], name: "auditLog_entity_entityId_idx")
  @@index([userId], name: "auditLog_userId_idx")
  @@index([adminId], name: "auditLog_adminId_idx")
  @@map("auditLog")
}


// ============================================================
// LEDGER ACCOUNT
// ============================================================

model LedgerAccount {
  id            Int           @id(map: "ledgerAccount_pkey") @default(autoincrement())
  active        Boolean       @default(true)
  code          String        @unique(map: "ledgerAccount_code_key")
  createdAt     Timestamptz   @default(now())
  currency      String
  name          String
  _type         String        @map("type")
  updatedAt     Timestamptz
  ledgerEntries LedgerEntry[]

  @@check(expression: "(currency = ANY (ARRAY['NGN'::text, 'USD'::text, 'EUR'::text, 'GBP'::text]))", map: "ledgerAccount_currency_check_4538a556")
  @@check(expression: "(type = ANY (ARRAY['ASSET'::text, 'LIABILITY'::text, 'REVENUE'::text, 'EXPENSE'::text, 'EQUITY'::text]))", map: "ledgerAccount_type_check_e2bdb04f")
  @@map("ledgerAccount")
}


// ============================================================
// WALLET
// ============================================================

model Wallet {
  id                      Int            @id(map: "wallet_pkey") @default(autoincrement())
  balance                 BigInt         @default(0)
  createdAt               Timestamptz    @default(now())
  currency                String
  status                  String         @default("ACTIVE")
  updatedAt               Timestamptz
  userId                  Int
  walletAccount           WalletAccount?
  transactions            Transaction[]  @relation(name: "transaction_destinationWalletId_fkey")
  transactionsTransaction Transaction[]  @relation(name: "transaction_sourceWalletId_fkey")
  user                    User           @relation(fields:[userId], references:[id], map: "wallet_userId_fkey")

  @@unique([userId, currency], map: "wallet_userId_currency_key")
  @@index([userId], name: "wallet_userId_idx")
  @@check(expression: "(currency = ANY (ARRAY['NGN'::text, 'USD'::text, 'EUR'::text, 'GBP'::text]))", map: "wallet_currency_check_4538a556")
  @@check(expression: "(status = ANY (ARRAY['ACTIVE'::text, 'FROZEN'::text, 'CLOSED'::text]))", map: "wallet_status_check_166abea7")
  @@map("wallet")
}


// ============================================================
// TRANSACTION
// ============================================================

model Transaction {
  id                  Int           @id(map: "transaction_pkey") @default(autoincrement())
  amount              BigInt
  createdAt           Timestamptz   @default(now())
  currency            String
  destinationWalletId Int?
  reference           String        @unique(map: "transaction_reference_key")
  sourceWalletId      Int?
  status              String        @default("PENDING")
  _type               String        @map("type")
  updatedAt           Timestamptz
  ledgerEntries       LedgerEntry[]
  destinationWallet   Wallet?       @relation(name: "transaction_destinationWalletId_fkey", fields:[destinationWalletId], references:[id], map: "transaction_destinationWalletId_fkey")
  sourceWallet        Wallet?       @relation(name: "transaction_sourceWalletId_fkey", fields:[sourceWalletId], references:[id], map: "transaction_sourceWalletId_fkey")

  @@index([destinationWalletId], name: "transaction_destinationWalletId_idx")
  @@index([sourceWalletId], name: "transaction_sourceWalletId_idx")
  @@check(expression: "(currency = ANY (ARRAY['NGN'::text, 'USD'::text, 'EUR'::text, 'GBP'::text]))", map: "transaction_currency_check_4538a556")
  @@check(expression: "(status = ANY (ARRAY['PENDING'::text, 'PROCESSING'::text, 'COMPLETED'::text, 'FAILED'::text, 'REVERSED'::text]))", map: "transaction_status_check_bc4cb609")
  @@check(expression: "(type = ANY (ARRAY['DEPOSIT'::text, 'WITHDRAWAL'::text, 'TRANSFER'::text]))", map: "transaction_type_check_3c3bc052")
  @@map("transaction")
}


// ============================================================
// LEDGER ENTRY
// ============================================================

model LedgerEntry {
  id            Int           @id(map: "ledgerEntry_pkey") @default(autoincrement())
  accountId     Int
  createdAt     Timestamptz   @default(now())
  credit        BigInt        @default(0)
  debit         BigInt        @default(0)
  transactionId Int
  account       LedgerAccount @relation(fields:[accountId], references:[id], map: "ledgerEntry_accountId_fkey")
  transaction   Transaction   @relation(fields:[transactionId], references:[id], map: "ledgerEntry_transactionId_fkey")

  @@index([accountId], name: "ledgerEntry_accountId_idx")
  @@index([transactionId], name: "ledgerEntry_transactionId_idx")
  @@map("ledgerEntry")
}


// ============================================================
// WALLET ACCOUNT
// ============================================================

model WalletAccount {
  id            Int         @id(map: "walletAccount_pkey") @default(autoincrement())
  accountName   String
  accountNumber String      @unique(map: "walletAccount_accountNumber_key")
  accountType   String      @default("VIRTUAL")
  bankCode      String?
  bankName      String
  createdAt     Timestamptz @default(now())
  status        String      @default("ACTIVE")
  updatedAt     Timestamptz
  walletId      Int         @unique(map: "walletAccount_walletId_key")
  wallet        Wallet      @relation(fields:[walletId], references:[id], map: "walletAccount_walletId_fkey")

  @@index([accountNumber], name: "walletAccount_accountNumber_idx")
  @@check(expression: "(\"accountType\" = ANY (ARRAY['SAVINGS'::text, 'CURRENT'::text, 'VIRTUAL'::text]))", map: "walletAccount_accountType_check_d5cd5637")
  @@check(expression: "(status = ANY (ARRAY['ACTIVE'::text, 'FROZEN'::text, 'SUSPENDED'::text, 'CLOSED'::text]))", map: "walletAccount_status_check_a25ed46d")
  @@map("walletAccount")
}

// ============================================================
// PAYMENT
// ============================================================

model Payment {
  id                    Int         @id(map: "payment_pkey") @default(autoincrement())
  reference             String      @unique(map: "payment_reference_key")
  sourceWalletId        Int
  destinationWalletId   Int
  amount                BigInt
  currency              String
  description           String?
  status                String      @default("PENDING")
  createdByAdminId      Int
  approvedByAdminId     Int?
  rejectedByAdminId     Int?
  rejectionReason       String?
  transactionId         Int?
  createdAt             Timestamptz @default(now())
  updatedAt             Timestamptz
  approvedAt            Timestamptz?
  rejectedAt            Timestamptz?

  @@index([status], name: "payment_status_idx")
  @@index([createdByAdminId], name: "payment_createdByAdminId_idx")
  @@index([sourceWalletId], name: "payment_sourceWalletId_idx")
  @@index([destinationWalletId], name: "payment_destinationWalletId_idx")
  @@index([createdAt], name: "payment_createdAt_idx")
  @@check(expression: "(status = ANY (ARRAY['PENDING'::text, 'APPROVED'::text, 'REJECTED'::text, 'PROCESSING'::text, 'COMPLETED'::text, 'FAILED'::text]))", map: "payment_status_check")
  @@check(expression: "(currency = ANY (ARRAY['NGN'::text, 'USD'::text, 'EUR'::text, 'GBP'::text]))", map: "payment_currency_check")
  @@check(expression: "(amount > 0)", map: "payment_amount_check")
  @@map("payment")
}

model ComplianceCase {
  id                  Int         @id @default(autoincrement())
  reference           String      @unique

  type                String
  priority            String
  status              String      @default("OPEN")

  title               String
  description         String

  transactionId       Int?
  walletId            Int?

  alertCode           String?

  createdByAdminId    Int
  assignedToAdminId   Int?

  resolutionNotes     String?

  escalationReason    String?
  escalatedByAdminId  Int?
  escalatedAt         Timestamptz?

  createdAt           Timestamptz @default(now())
  updatedAt           Timestamptz

  @@index([status])
  @@index([priority])
  @@index([type])
  @@index([createdByAdminId])
  @@index([assignedToAdminId])
  @@index([transactionId])
  @@index([walletId])
  @@index([createdAt])

  @@map("complianceCase")
}

// ============================================================
// RISK ALERT
// ============================================================

model RiskAlert {
  id                  Int          @id @default(autoincrement())
  reference           String       @unique

  type                String
  severity            String
  status              String       @default("OPEN")

  title               String
  description         String

  transactionId       Int?
  walletId            Int?
  userId              Int?

  complianceCaseId    Int?

  alertCode           String?

  createdByAdminId    Int
  assignedToAdminId   Int?

  resolutionNotes     String?
  falsePositiveReason String?

  flaggedByAdminId    Int?
  flaggedAt           Timestamptz?

  releasedByAdminId   Int?
  releasedAt          Timestamptz?

  createdAt           Timestamptz  @default(now())
  updatedAt           Timestamptz

  @@index([status])
  @@index([severity])
  @@index([type])
  @@index([createdByAdminId])
  @@index([transactionId])
  @@index([walletId])
  @@index([userId])
  @@index([complianceCaseId])
  @@index([createdAt])

  @@map("riskAlert")
}

// ============================================================
// RECONCILIATION
// ============================================================

model ReconciliationRun {
  id                     Int                   @id @default(autoincrement())
  reference              String                @unique

  status                 String                @default("PENDING")
  type                   String

  periodStart            Timestamptz
  periodEnd              Timestamptz

  totalTransactions      Int                   @default(0)
  matchedCount           Int                   @default(0)
  unmatchedCount         Int                   @default(0)
  discrepancyCount       Int                   @default(0)
  totalDiscrepancyAmount BigInt                @default(0)

  notes                  String?
  failureReason          String?

  createdByAdminId       Int
  approvedByAdminId      Int?
  approvedAt             Timestamptz?

  createdAt              Timestamptz           @default(now())
  updatedAt              Timestamptz

  entries                ReconciliationEntry[]

  @@index([status])
  @@index([type])
  @@index([createdByAdminId])
  @@index([createdAt])

  @@map("reconciliationRun")
}

model ReconciliationEntry {
  id                  Int               @id @default(autoincrement())
  runId               Int
  transactionId       Int
  status              String

  transactionAmount   BigInt
  ledgerDebitTotal    BigInt            @default(0)
  ledgerCreditTotal   BigInt            @default(0)
  discrepancyAmount   BigInt            @default(0)

  currency            String
  notes               String?

  createdAt           Timestamptz       @default(now())

  run                 ReconciliationRun @relation(fields:[runId], references:[id], map: "reconciliationEntry_runId_fkey")

  @@index([runId])
  @@index([transactionId])
  @@index([status])

  @@map("reconciliationEntry")
}

// ============================================================
// SYSTEM SETTINGS
// ============================================================

model SystemSetting {
  id               Int         @id @default(autoincrement())
  key              String      @unique
  value            String
  description      String?
  category         String      @default("GENERAL")
  dataType         String      @default("STRING")
  updatedByAdminId Int?
  createdAt        Timestamptz @default(now())
  updatedAt        Timestamptz

  @@index([category])
  @@map("systemSetting")
}